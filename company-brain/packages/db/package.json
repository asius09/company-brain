{
  "name": "@company-brain/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./repositories/*": "./src/repositories/*.ts",
    "./client": "./src/client.ts",
    "./tenant": "./src/tenant.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/scripts/migrate.ts",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "seed": "tsx src/scripts/seed.ts",
    "reset": "tsx src/scripts/reset.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@company-brain/core": "workspace:*",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@company-brain/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.0"
  }
}
